---
import { getDictionary, getLocaleFromPath, normalizeLocale, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const locale = normalizeLocale(Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getDictionary(locale).theme;
---
<label class="theme-control" data-theme-picker hidden>
  <span aria-hidden="true">◐</span>
  <span class="sr-only">{copy.label}</span>
  <select data-theme-control aria-label={copy.label}>
    <option value="system">{copy.system}</option>
    <option value="light">{copy.light}</option>
    <option value="dark">{copy.dark}</option>
  </select>
</label>
