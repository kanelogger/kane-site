---
const links = [['WORK', '/work'], ['WRITING', '/writing'], ['ABOUT', '/about']];
---
<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="wordmark" aria-label="KANE 首页">KANE<span aria-hidden="true">↗</span></a>
    <nav aria-label="主导航">{links.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
  </div>
</header>
