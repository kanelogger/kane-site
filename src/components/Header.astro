---
import { getAlternateLocale, getDictionary, getLocaleFromPath, getLocalePath, normalizeLocale, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; alternateHref?: string; }
const locale = normalizeLocale(Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getDictionary(locale);
const links = [[copy.nav.work, '/work'], [copy.nav.writing, '/writing'], [copy.nav.apps, '/apps']];
const route = locale === 'en' && Astro.url.pathname.startsWith('/en') ? Astro.url.pathname.slice(3) || '/' : Astro.url.pathname;
const alternateLocale = getAlternateLocale(locale);
const alternateHref = Astro.props.alternateHref ?? getLocalePath(alternateLocale, route);
---
<header class="site-header">
  <div class="shell header-inner">
    <a href={getLocalePath(locale, '/')} class="wordmark" aria-label="Kane"><span class="brand-symbol" aria-hidden="true">k.</span><span>KANELOGGER</span></a>
    <nav aria-label={copy.nav.primary}>{links.map(([label, href]) => <a href={getLocalePath(locale, href)} aria-current={route.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
    <a class="language-switch" href={alternateHref} lang={alternateLocale} hreflang={alternateLocale}>{copy.nav.language}</a>
  </div>
</header>
