---
import ThemeControl from './ThemeControl.astro';
import defaultData from '../data/app-navigation-defaults.json';
import { appCategoryHue } from '../lib/app-category-colors';
import { getDictionary, type Locale } from '../lib/i18n';
import '@fontsource-variable/manrope';
import '@fontsource-variable/noto-sans-sc';
import '../styles/apps-base.css';
import '../styles/app-navigation.css';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getDictionary(locale).apps;
const starterApps = defaultData.apps.map((app) => ({
  id: app.id,
  name: app.name,
  url: app.url,
  category: app.category,
  sortOrder: app.sortOrder,
  description: app.description,
  shortcode: app.shortcode.slice(0, 2),
  favorite: app.favorite,
}));
const fallbackGroups = defaultData.categories.map((category) => ({
  category,
  apps: starterApps.filter((app) => app.category === category),
}));
const bootstrap = JSON.stringify({ copy, starterApps, starterCategories: defaultData.categories }).replaceAll('<', '\\u003c');
---
<svg class="apps-svg-sprite" aria-hidden="true">
  <symbol id="apps-icon-more" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle></symbol>
  <symbol id="apps-icon-category" viewBox="0 0 24 24"><path d="M8 6h12M8 12h12M8 18h12M3 6h.01M3 12h.01M3 18h.01"></path></symbol>
  <symbol id="apps-icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></symbol>
  <symbol id="apps-icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></symbol>
  <symbol id="apps-icon-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="7.5" ry="3"></ellipse><path d="M4.5 5.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6M4.5 11.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6"></path></symbol>
  <symbol id="apps-icon-star" viewBox="0 0 24 24"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"></path></symbol>
  <symbol id="apps-icon-arrow" viewBox="0 0 24 24"><path d="M5 19 19 5M9 5h10v10"></path></symbol>
  <symbol id="apps-icon-upload" viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v5h14v-5"></path></symbol>
  <symbol id="apps-icon-download" viewBox="0 0 24 24"><path d="M12 4v12m0 0 4.5-4.5M12 16l-4.5-4.5M5 19h14"></path></symbol>
  <symbol id="apps-icon-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5"></path></symbol>
  <symbol id="apps-icon-edit" viewBox="0 0 24 24"><path d="m4 16.5-.5 4 4-.5L19 8.5 15.5 5 4 16.5ZM13.5 7l3.5 3.5"></path></symbol>
  <symbol id="apps-icon-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></symbol>
  <symbol id="apps-icon-chevron" viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"></path></symbol>
  <symbol id="apps-icon-check" viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"></path></symbol>
</svg>

<div class="apps-shell" data-app-navigation data-ready="false" aria-busy="true">
  <script is:inline type="application/json" data-app-navigation-bootstrap set:html={bootstrap}></script>

  <div class="apps-toolbar">
    <div class="apps-toolbar-inner">

      <div class="apps-header-actions">
        <button class="apps-action apps-action-primary" type="button" data-add-button data-app-enhancement aria-label={copy.add}><svg aria-hidden="true"><use href="#apps-icon-plus"></use></svg><span>{copy.add}</span></button>
        <div class="apps-data-control" data-app-enhancement>
          <button class="apps-action apps-action-secondary" type="button" data-data-menu-button aria-label={copy.openData} aria-expanded="false" aria-controls="apps-data-menu">
            <svg aria-hidden="true"><use href="#apps-icon-database"></use></svg><span>{copy.data}</span><svg class="apps-chevron" aria-hidden="true"><use href="#apps-icon-chevron"></use></svg>
          </button>
          <div class="apps-data-menu" id="apps-data-menu" data-data-menu hidden>
            <button type="button" data-import-button><svg aria-hidden="true"><use href="#apps-icon-upload"></use></svg><span><strong>{copy.import}</strong><small>{copy.importHint}</small></span></button>
            <button type="button" data-export-button><svg aria-hidden="true"><use href="#apps-icon-download"></use></svg><span><strong>{copy.export}</strong><small>{copy.exportHint}</small></span></button>
            <div class="apps-menu-separator"></div>
            <button class="apps-danger-menu-item" type="button" data-clear-button><svg aria-hidden="true"><use href="#apps-icon-trash"></use></svg><span><strong>{copy.clear}</strong><small>{copy.clearHint}</small></span></button>
          </div>
        </div>
        <ThemeControl locale={locale} />
      </div>
    </div>
  </div>

  <div class="apps-workspace" id="workspace-content" tabindex="-1">
    <aside class="apps-category-panel" data-category-desktop data-app-enhancement>
      <div class="apps-category-surface" data-category-panel>
        <header><h2 id="apps-category-title">{copy.categoryIndex}</h2><button class="apps-icon-button apps-mobile-category-close" type="button" data-close-categories aria-label={copy.closeCategories}><svg aria-hidden="true"><use href="#apps-icon-close"></use></svg></button></header>
        <nav class="apps-category-list" data-category-atlas aria-label={copy.filterByCategory}></nav>
      </div>
    </aside>
    <div class="apps-main">
      <header class="apps-page-heading"><h1>{copy.title}</h1><p>{copy.intro}</p></header>
      <p class="apps-loading" data-app-loading role="status" hidden>{copy.loading}</p>
      <section class="apps-storage-error" data-storage-error role="alert" hidden><h2>{copy.storageUnavailableTitle}</h2><p>{copy.storageUnavailable}</p><button class="apps-action" type="button" data-retry-storage>{copy.retry}</button></section>
      <section class="apps-command-bar" aria-label={copy.searchLabel} data-app-enhancement>
        <div class="apps-command-tools">
          <label class="apps-search">
            <svg aria-hidden="true"><use href="#apps-icon-search"></use></svg>
            <span class="sr-only">{copy.searchLabel}</span>
            <input type="search" data-search-input placeholder={copy.searchPlaceholder} autocomplete="off" />
            <kbd aria-hidden="true">⌘ K</kbd>
          </label>
          <button class="apps-action apps-mobile-category-trigger" type="button" data-open-categories aria-label={copy.chooseCategory} aria-haspopup="dialog" aria-controls="apps-category-dialog"><svg aria-hidden="true"><use href="#apps-icon-category"></use></svg><span data-current-category>{copy.exploreAll}</span><span class="apps-category-trigger-count" data-current-category-count>0</span><svg class="apps-chevron" aria-hidden="true"><use href="#apps-icon-chevron"></use></svg></button>
          <select class="apps-sort" data-sort-select aria-label={copy.sortLabel}>
            <option value="default">{copy.sortDefault}</option>
            <option value="name">{copy.sortName}</option>
            <option value="category">{copy.sortCategory}</option>
          </select>
        </div>
      </section>
      <section class="apps-quick" data-app-enhancement aria-labelledby="apps-quick-title">
        <div class="apps-quick-label"><h2 id="apps-quick-title">{copy.quickTitle}</h2></div>
        <div class="apps-quick-list" data-favorite-orbit></div>
        <details class="apps-favorite-overflow" data-favorite-overflow hidden><summary><span data-favorite-overflow-label></span></summary><div class="apps-quick-list" data-favorite-overflow-list></div></details>
      </section>
      <section class="apps-directory" data-app-enhancement aria-label={copy.directoryLabel}>
        <div class="apps-directory-main">
          <header class="apps-directory-head">
            <div><h2 data-explore-title>{copy.exploreAll}</h2><p data-result-count role="status" aria-live="polite" aria-atomic="true">0 {copy.appCount}</p></div>
            <button class="apps-action apps-action-quiet" type="button" data-reset-filter hidden>{copy.backToAtlas}</button>
          </header>
          <div class="apps-grid" data-app-list></div>
        </div>
      </section>
      <section class="apps-noscript" data-app-fallback aria-labelledby="apps-fallback-title">
        <div class="apps-section-heading"><h2 id="apps-fallback-title">{copy.defaultDirectory}</h2><noscript><p>{copy.noScript}</p></noscript></div>
        <div class="apps-fallback-groups">
          {fallbackGroups.map((group, index) => (
            <section class="apps-fallback-group" style={{ '--atlas-category-hue': appCategoryHue(index) }}><h3>{group.category}</h3><ul>{group.apps.map((app) => <li><a href={app.url} target="_blank" rel="noreferrer">{app.name}</a>{app.description && <p>{app.description}</p>}</li>)}</ul></section>
          ))}
        </div>
      </section>
    </div>
  </div>

  <dialog class="apps-dialog apps-category-dialog" id="apps-category-dialog" data-category-dialog aria-labelledby="apps-category-title"></dialog>

  <input type="file" accept="application/json,.json" data-import-input hidden />

  <dialog class="apps-dialog" data-app-dialog aria-labelledby="apps-form-title">
    <form data-app-form method="dialog" novalidate>
      <div class="apps-dialog-header"><div><span class="apps-eyebrow" data-form-eyebrow>{copy.newEntry}</span><h2 id="apps-form-title" data-form-title>{copy.add}</h2></div><button class="apps-icon-button" type="button" data-close-app-dialog aria-label={copy.close}><svg aria-hidden="true"><use href="#apps-icon-close"></use></svg></button></div>
      <input type="hidden" data-app-id />
      <div class="apps-form-grid">
        <label class="apps-field apps-field-wide"><span>{copy.name} <b aria-label={copy.required}>*</b></span><input name="name" type="text" data-app-name aria-describedby="apps-error-name" placeholder={copy.namePlaceholder} required maxlength="80" /><small class="apps-error" id="apps-error-name" data-error-for="name"></small></label>
        <label class="apps-field apps-field-wide"><span>{copy.url} <b aria-label={copy.required}>*</b></span><input name="url" type="url" data-app-url aria-describedby="apps-error-url" placeholder={copy.urlPlaceholder} required maxlength="2048" /><small class="apps-error" id="apps-error-url" data-error-for="url"></small></label>
        <label class="apps-field"><span>{copy.category} <b aria-label={copy.required}>*</b></span><input name="category" type="text" data-app-category aria-describedby="apps-error-category" list="apps-category-options" placeholder={copy.categoryPlaceholder} required maxlength="40" /><datalist id="apps-category-options" data-category-options></datalist><small class="apps-error" id="apps-error-category" data-error-for="category"></small></label>
        <label class="apps-field"><span>{copy.shortcode}</span><input name="shortcode" type="text" data-app-shortcode placeholder={copy.shortcodePlaceholder} maxlength="2" /></label>
        <label class="apps-field apps-field-wide"><span>{copy.appDescription}</span><textarea name="description" rows="3" data-app-description placeholder={copy.descriptionPlaceholder} maxlength="240"></textarea></label>
        <label class="apps-favorite-toggle apps-field-wide"><input name="favorite" type="checkbox" data-app-favorite /><span class="apps-fake-check"><svg aria-hidden="true"><use href="#apps-icon-check"></use></svg></span><span><strong>{copy.favorite}</strong><small>{copy.favoriteHint}</small></span></label>
      </div>
      <p class="apps-form-status" data-app-form-error role="alert" hidden></p>
      <div class="apps-dialog-footer"><button class="apps-action apps-action-quiet" type="button" data-cancel-app-dialog>{copy.cancel}</button><button class="apps-action apps-action-primary" type="submit"><span data-save-label>{copy.save}</span><svg aria-hidden="true"><use href="#apps-icon-arrow"></use></svg></button></div>
    </form>
  </dialog>

  <dialog class="apps-dialog apps-dialog-small" data-confirm-dialog aria-labelledby="apps-confirm-title" aria-describedby="apps-confirm-message">
    <form method="dialog" data-confirm-form><span class="apps-confirm-index">!</span><h2 id="apps-confirm-title" data-confirm-title></h2><p id="apps-confirm-message" data-confirm-message></p><p class="apps-form-status" data-confirm-error role="alert" hidden></p><div class="apps-dialog-footer"><button class="apps-action apps-action-quiet" type="button" data-confirm-cancel>{copy.cancel}</button><button class="apps-action apps-action-danger" type="submit" data-confirm-action></button></div></form>
  </dialog>

  <div class="apps-toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>
</div>

<script>
  import '../scripts/app-navigation';
</script>
