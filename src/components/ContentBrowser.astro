---
import type { CollectionEntry } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { imageSize } from 'image-size';
import { formatDate, readingMinutes } from '../lib/content';
import { getDictionary, getLocaleFromPath, getLocalePath, normalizeLocale, type Locale } from '../lib/i18n';
import { getMediaVariant } from '../data/media';

interface Props {
  title: string;
  description: string;
  articles?: CollectionEntry<'blog'>[];
  projects?: CollectionEntry<'projects'>[];
  categories?: boolean;
  locale?: Locale;
}
const { title, description, articles = [], projects = [], categories = false } = Astro.props;
const locale = normalizeLocale(Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getDictionary(locale);
const categoryNames = [...new Set(articles.map((article) => article.data.category))];
const coverMedia = projects.map(({ data }) => {
  const variant = getMediaVariant(data.cover, locale);
  const src = variant?.src ?? data.cover;
  return { ...variant, src, size: imageSize(readFileSync(join(process.cwd(), 'public', src))) };
});
const count = projects.length + articles.length;
const entryPath = (type: 'writing' | 'work', slug: string, status: string) =>
  getLocalePath(locale === 'en' && status !== 'reviewed' ? 'zh-CN' : locale, `/${type}/${slug}`);
---
<div class="content-browser" data-content-browser>
  <header class="workspace-heading"><div><h1>{title}<span aria-hidden="true">_</span></h1><p>{description}</p></div><span class="workspace-total">{String(count).padStart(2, '0')} {copy.content.entriesLabel}</span></header>
  <div class="content-tools" data-content-tools hidden>
    <div class="content-search-line">
      <label class="content-search"><span aria-hidden="true">⌕</span><span class="sr-only">{copy.content.searchLabel}</span><input type="search" name="q" data-content-query autocomplete="off" placeholder={copy.content.searchPlaceholder} aria-controls="content-results" /></label>
      <button class="content-clear" type="button" data-clear-filters hidden>{copy.content.clear}</button>
      <p class="content-result-count" data-result-count role="status" aria-live="polite" aria-atomic="true">{count} {copy.content.entries}</p>
    </div>
    {categories && <div class="content-categories" data-content-category role="group" aria-label={copy.content.categories}><button type="button" data-category="" aria-pressed="true">{copy.content.allCategories}</button>{categoryNames.map((category) => <button type="button" data-category={category} aria-pressed="false">{category}</button>)}</div>}
  </div>
  <div id="content-results">
    {projects.length > 0 && <section class="content-group" data-content-group aria-labelledby="workspace-projects">
      <header class="content-group-heading"><h2 id="workspace-projects">{copy.content.projects}</h2><span><span data-group-count>{String(projects.length).padStart(2, '0')}</span> {copy.content.projectLabel}</span></header>
      <div class="content-rows">{projects.map((project, index) => { const slug = (project.data as { slug?: string }).slug ?? project.id.split('/').pop() ?? project.id; return <article class="content-row content-project-row" data-content-row data-search={[project.data.title, project.data.description, project.data.cardDescription ?? '', ...project.data.tags].join(' ')}>
        <a class:list={['content-project-image', { 'content-skills-image': project.id.endsWith('kane-skills') }]} href={entryPath('work', slug, project.data.translationStatus)} data-result-link tabindex="-1" aria-hidden="true"><img src={coverMedia[index].src} alt={coverMedia[index].alt ?? copy.content.coverAlt(project.data.title)} width={coverMedia[index].size.width} height={coverMedia[index].size.height} loading="lazy" decoding="async" /></a>
        <div class="content-row-copy"><h3><a href={entryPath('work', slug, project.data.translationStatus)} data-result-link>{project.data.title}{locale === 'en' && project.data.translationStatus !== 'reviewed' && <small> ({copy.content.original})</small>}<span aria-hidden="true">↗</span></a></h3><p>{project.data.cardDescription ?? project.data.description}</p><ul class="content-row-tags" aria-label={copy.content.tags}>{project.data.tags.map((tag) => <li>{tag}</li>)}</ul></div>
        <span class="content-row-year">{project.data.year}</span>
      </article>; })}</div>
    </section>}
    {articles.length > 0 && <section class="content-group" data-content-group aria-labelledby="workspace-articles">
      <header class="content-group-heading"><h2 id="workspace-articles">{copy.content.articles}</h2><span><span data-group-count>{String(articles.length).padStart(2, '0')}</span> {copy.content.articleLabel}</span></header>
      <div class="content-rows">{articles.map((article) => { const slug = (article.data as { slug?: string }).slug ?? article.id.split('/').pop() ?? article.id; return <article class="content-row content-article-row" data-content-row data-category={article.data.category} data-search={[article.data.title, article.data.description, ...article.data.tags].join(' ')}>
        <div class="content-row-copy"><div class="content-article-meta"><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time><span>{article.data.category}</span><span>{copy.content.minutes(readingMinutes(article.body))}</span></div><h3><a href={entryPath('writing', slug, article.data.translationStatus)} data-result-link>{article.data.title}{locale === 'en' && article.data.translationStatus !== 'reviewed' && <small> ({copy.content.original})</small>}<span aria-hidden="true">↗</span></a></h3><p>{article.data.description}</p><ul class="content-row-tags" aria-label={copy.content.tags}>{article.data.tags.map((tag) => <li>{tag}</li>)}</ul></div>
      </article>; })}</div>
    </section>}
  </div>
  <div class="content-empty" data-content-empty hidden><h2>{copy.content.noMatches}</h2><p>{copy.content.noMatchesHint}</p><button class="content-empty-clear" type="button" data-clear-filters>{copy.content.clear}</button></div>
</div>
