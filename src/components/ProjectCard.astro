---
import type { CollectionEntry } from 'astro:content';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { imageSize } from 'image-size';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data, id } = project;
const dimensions = imageSize(readFileSync(resolve('public', data.cover.slice(1))));
---
<article class="project" data-home-reveal>
  <a class="project-image-link" href={`/work/${id}`} aria-label={`查看 ${data.title} 项目详情`}>
    <img src={data.cover} alt={id === 'kane-skills' ? 'Kane Q 工作状态角色' : `${data.title} 项目封面`} width={dimensions.width} height={dimensions.height} loading="lazy" decoding="async" />
    <span class="image-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-summary">
    <div class="project-top meta"><span>{data.tags.slice(0, 3).join(' / ')}</span><span>{data.year}</span></div>
    <h3><a href={`/work/${id}`}>{data.title}<span aria-hidden="true">↗</span></a></h3>
    <p>{data.cardDescription ?? data.description}</p>
    <a class="text-link" href={data.github}>GitHub <span aria-hidden="true">↗</span></a>
  </div>
</article>
