---
import type { CollectionEntry } from 'astro:content';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { imageSize } from 'image-size';
import { getDictionary, getLocaleFromPath, getLocalePath, normalizeLocale, type Locale } from '../lib/i18n';
import { getMediaVariant } from '../data/media';
interface Props { project: CollectionEntry<'projects'>; locale?: Locale; }
const { project } = Astro.props;
const { data, id } = project;
const locale = normalizeLocale(Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getDictionary(locale);
const slug = (data as { slug?: string }).slug ?? id.split('/').pop() ?? id;
const media = getMediaVariant(data.cover, locale);
const imageSrc = media?.src ?? data.cover;
const dimensions = imageSize(readFileSync(resolve('public', imageSrc.slice(1))));
---
<article class="project" data-home-reveal>
  <a class="project-image-link" href={getLocalePath(locale, `/work/${slug}`)} aria-label={copy.content.viewProject(data.title)}>
    <img src={imageSrc} alt={media?.alt ?? (id.endsWith('kane-skills') ? (locale === 'en' ? 'Kane Q working state character' : 'Kane Q 工作状态角色') : copy.content.coverAlt(data.title))} width={dimensions.width} height={dimensions.height} loading="lazy" decoding="async" />
    <span class="image-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-summary">
    <div class="project-top meta"><span>{data.tags.slice(0, 3).join(' / ')}</span><span>{data.year}</span></div>
    <h3><a href={getLocalePath(locale, `/work/${slug}`)}>{data.title}<span aria-hidden="true">↗</span></a></h3>
    <p>{data.cardDescription ?? data.description}</p>
    {data.github && <a class="text-link" href={data.github}>{copy.common.github} <span aria-hidden="true">↗</span></a>}
  </div>
</article>
