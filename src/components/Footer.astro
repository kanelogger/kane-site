---
import QuickLinks from './QuickLinks.astro';
import { getDictionary, getLocaleFromPath, normalizeLocale, type Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const locale = normalizeLocale(Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getDictionary(locale);
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-bottom"><span>© {new Date().getFullYear()} Kane</span><QuickLinks locale={locale} /><a href="#top">{copy.footer.backToTop}</a></div>
  </div>
</footer>
