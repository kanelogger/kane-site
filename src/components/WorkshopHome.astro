---
import '../styles/workshop.css';
import '../styles/workshop-hero.css';
import HeroPortrait from './HeroPortrait.astro';
import ContactIcon from './ContactIcon.astro';
import WorkshopScene from './WorkshopScene.astro';
import WelcomeMascot from './WelcomeMascot.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { getDictionary, getLocalePath, type Locale } from '../lib/i18n';
interface Props { locale?: Locale }
const { locale = 'zh-CN' } = Astro.props;
const en = locale === 'en';
const dictionary = getDictionary(locale);
const copy = dictionary.workshop;
const projectCovers = new Map((await getCollection('projects', ({ data }) => data.locale === 'zh-CN')).map(({ data }) => [data.slug, data]));
const localizedCovers = new Map((await getCollection('projects', ({ data }) => data.locale === locale)).map(({ data }) => [data.slug, data]));
const coverAlt = (slug: string) => localizedCovers.get(slug)?.coverAlt ?? projectCovers.get(slug)!.coverAlt;
const title = copy.title;
const description = copy.description;
const canonical = new URL(getLocalePath(locale, '/'), Astro.site!);
const shareImage = new URL('/og.png', Astro.site!);
const alternateLocale = en ? 'zh-CN' : 'en';
const noteSlugs = ['agent-project-recovery', 'agent-hard-gates', en ? 'ai-native-development-system' : 'learning-pi-in-practice'];
const articles = new Map((await getCollection('blog', ({ data }) => data.locale === locale)).map(({ data }) => [data.slug, data]));
const projects = [
  { slug: 'skill-port', platform: 'CLI + Desktop', description: copy.skillDescription },
  { slug: 'quota-bar', platform: 'macOS', description: copy.quotaDescription },
  { slug: 'kane-skills', platform: 'Agent Skills', description: copy.skillsDescription },
];
---
<!doctype html>

<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f8f5ec">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="canonical" href={canonical}>
  <meta property="og:site_name" content="KANE">
  <meta property="og:locale" content={en ? 'en_US' : 'zh_CN'}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={shareImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={shareImage}>
  <link rel="alternate" hreflang="zh-CN" href={new URL('/', Astro.site!)}>
  <link rel="alternate" hreflang="en" href={new URL('/en', Astro.site!)}>
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site!)}>
  <link rel="alternate" type="application/rss+xml" title={en ? 'KANE writing' : 'KANE 的文章'} href={getLocalePath(locale, '/rss.xml')}>
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script>import '../scripts/workshop.js';</script>
</head>
<body data-workshop-home>
  <a class="skip" href="#main">{dictionary.common.skipToMain}</a>
  <header class="site-header" data-tone="hero">
    <div class="nav-wrap">
      <a class="wordmark" href="#top" aria-label={copy.backToTop}><span class="brand-symbol" aria-hidden="true">k.</span><span>KANELOGGER</span></a>
      <nav aria-label={dictionary.nav.primary}><a href="#work">{dictionary.nav.work}</a><a href="#notes">{copy.notes}</a><a href="#contact">{copy.contactTitle}</a></nav>
      <div class="header-tools"><a class="apps-link" href={getLocalePath(locale, '/apps')} data-astro-reload>{dictionary.nav.apps}</a><a class="language-switch" href={getLocalePath(alternateLocale, '/')} lang={alternateLocale} hreflang={alternateLocale} data-astro-reload>{dictionary.nav.language}</a></div>
    </div>
  </header>
  <main id="main" tabindex="-1">
    <section class="hero" id="top" data-section-tone="hero" aria-labelledby="hero-title" data-screen-label={en ? 'Workshop hero' : '工作台首屏'}>
      <div class="shell hero-inner">
        <div class="hero-identity">
          <div class="hero-avatar">
            <HeroPortrait label={copy.portraitAlt} />
          </div>
          <div class="hero-greeting">
            <p class="eyebrow">SOFTWARE ENGINEER · MAKER</p>
            <h1 id="hero-title">{copy.heroGreeting}<span class="hero-name">Kane<span class="hero-period">.</span></span></h1>
          </div>
        </div>
        <div class="hero-statement">
          <p>{copy.statementExperience}</p>
          <p>{copy.statementFocus}</p>
          <p>{copy.statementRecord}<a href={getLocalePath(locale, '/work')}>{copy.productsLabel}</a>{copy.statementWritingJoin}<a href={getLocalePath(locale, '/writing')}>{copy.articlesLabel}</a>{copy.statementPeriod}</p>
          <p>{copy.statementContact}<a href="#contact">{copy.contactLinkLabel}</a>{copy.statementPeriod}</p>
        </div>
        <div class="hero-actions">
          <a class="hero-primary" href="#work">{copy.explore}</a>
          <a class="hero-secondary" href="#notes">{copy.readNotes}</a>
          <button class="hero-redraw" type="button" aria-label={copy.redrawLabel} hidden><span aria-hidden="true">↻</span> {copy.redraw}</button>
        </div>
        <div class="hero-scene">
          <WorkshopScene label={copy.sceneAlt} />
          <div class="workshop-welcome" aria-hidden="true">
            <WelcomeMascot />
            <div class="workshop-bubble">
              <span class="bubble-eyebrow">SOFTWARE ENGINEER · MAKER</span>
              <span class="bubble-greeting">{copy.heroGreeting}Kane<span class="hero-period">.</span></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="work section-space" id="work" data-section-tone="paper" aria-labelledby="work-title" data-screen-label={en ? 'Work' : '作品'}>
      <div class="shell">
        <div class="section-heading">
          <p class="section-label">{copy.workLabel}</p>
          <h2 id="work-title">{copy.workTitle}</h2>
          <p class="section-intro">{copy.workIntro}</p>
        </div>
        <ul class="project-list">
          {projects.map(({ slug, platform, description }) => {
            const project = projectCovers.get(slug)!;
            return <li>
              <a class="project-entry" href={getLocalePath(en && localizedCovers.get(slug)?.translationStatus !== 'reviewed' ? 'zh-CN' : locale, `/work/${slug}`)} aria-labelledby={`project-${slug}`}>
                <div class="project-copy">
                  <div class="project-heading"><h3 id={`project-${slug}`}>{project.title}</h3><span class="project-platform">{platform}</span></div>
                  <p>{description}</p>
                </div>
                <img class="project-cover" src={project.cover} width="1200" height="900" loading="lazy" decoding="async" alt={coverAlt(slug)}>
              </a>
            </li>;
          })}
        </ul>
        <a class="text-link" href={getLocalePath(locale, '/work')}>{copy.moreWork}</a>
      </div>
    </section>

    <section class="notes section-space" id="notes" data-section-tone="paper" aria-labelledby="notes-title" data-screen-label={en ? 'Articles' : '文章'}>
      <div class="shell">
        <div class="section-heading">
          <p class="section-label">{copy.notesLabel}</p>
          <h2 id="notes-title">{copy.notesTitle}</h2>
          <p class="section-intro">{copy.notesIntro}</p>
        </div>
        <ul class="note-list">
          {noteSlugs.map((slug, index) => <li>
            <a class="note" href={getLocalePath(locale, `/writing/${slug}`)} aria-labelledby={`note-${slug}`}>
              <div class="note-copy">
                <h3 id={`note-${slug}`}>{articles.get(slug)!.title}</h3>
                <p>{copy.noteDescriptions[index]}</p>
              </div>
              <img class="note-cover" src={articles.get(slug)!.cover} width="1200" height="900" loading="lazy" decoding="async" alt={articles.get(slug)!.coverAlt}>
            </a>
          </li>)}
        </ul>
        <a class="text-link" href={getLocalePath(locale, '/writing')}>{copy.moreNotes}</a>
      </div>
    </section>

    <section class="find-me section-space" id="contact" data-section-tone="paper" aria-labelledby="contact-title" data-screen-label={copy.contactTitle}>
      <div class="shell">
        <div class="section-heading"><p class="section-label">{copy.contactLabel}</p><h2 id="contact-title">{copy.contactTitle}</h2><p class="section-intro">{copy.contactIntro}</p></div>
        <div class="contact-identity">
          <div class="contact-profile">
            <img class="contact-avatar" src="/assets/contact/kane-avatar.jpg" width="940" height="940" loading="lazy" decoding="async" alt={copy.contactAvatarAlt}>
            <p class="contact-identity-name">Kane <span>@kanelogger</span></p>
          </div>
          <div class="contact-socials" role="group" aria-label={copy.contactSocials}>
            <div class="contact-links">
              {site.contacts.map((contact, index) => <a class="contact-icon" href={contact.href} aria-label={`${contact.name} · @kanelogger`} title={`${contact.name} · @kanelogger`}><ContactIcon name={index === 0 ? 'github' : 'x'} /></a>)}
              <a class="contact-icon" href="https://weibo.com/u/2272877934" aria-label={copy.weibo} title={copy.weibo}><ContactIcon name="sinaweibo" /></a>
            </div>
            <details class="contact-wechat">
              <summary class="contact-icon" title={`${copy.wechat} · GeekGuru`}><ContactIcon name="wechat" /><span class="contact-sr-only">{copy.wechat} GeekGuru</span></summary>
              <div class="contact-qr"><img src="/assets/contact/geekguru-qr.jpg" width="258" height="258" loading="lazy" decoding="async" alt={copy.wechatQrAlt}><p>{copy.wechatScan}</p></div>
            </details>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Kane</span><a href="#top">{dictionary.footer.backToTop}</a></div></footer>

  <noscript><p class="noscript-note">{copy.noscript}</p></noscript>
</body>
</html>
