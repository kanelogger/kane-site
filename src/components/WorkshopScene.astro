<style>
  .hero-workshop {
    position: relative;
    aspect-ratio: 3 / 2;
    min-width: 0;
    margin: 0;
    mix-blend-mode: multiply;
    /* Fade only the surrounding ground; keep the house, shelves and garden crisp. */
    mask-image: linear-gradient(to right, transparent, var(--ink) 6%, var(--ink) 94%, transparent), linear-gradient(to bottom, transparent, var(--ink) 13%, var(--ink) 86%, transparent);
    mask-composite: intersect;
  }
  .scene-image { display: block; width: 100%; height: 100%; object-fit: contain; }
  .scene-outline { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
  .scene-structure, .scene-pipes { fill: none; stroke: var(--ink); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .scene-pipes { stroke: var(--accent); stroke-width: 4; }
  .scene-fine { stroke-width: 2.4; }
  .scene-line { stroke-dasharray: 1 2; stroke-dashoffset: 0; }
  .hero-workshop[data-drawing] .scene-line { animation: scene-stroke .56s ease-out var(--delay) both; }
  .hero-workshop[data-drawing] .scene-outline { animation: scene-outline-out 2.8s linear both; }
  .hero-workshop[data-drawing] .scene-image { animation: scene-image-in 2.8s ease-in-out both; }
  @keyframes scene-stroke { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes scene-outline-out { 0%, 65% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes scene-image-in { 0%, 65% { opacity: 0; } 100% { opacity: 1; } }
  .hero-workshop[data-image-error] .scene-image { display: none; }
  .hero-workshop[data-image-error] .scene-outline { opacity: 1; }
  .hero-workshop[data-image-error] .scene-line { stroke-dashoffset: 0; }
  .hero-workshop[data-image-error] .scene-image,
  .hero-workshop[data-image-error] .scene-outline,
  .hero-workshop[data-image-error] .scene-line { animation: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-workshop[data-drawing] .scene-image,
    .hero-workshop[data-drawing] .scene-outline,
    .hero-workshop[data-drawing] .scene-line { animation: none; }
  }
</style>
