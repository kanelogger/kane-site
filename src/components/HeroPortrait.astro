<style>
  .hero-portrait {
    --portrait-line: #342c28;
    --portrait-hood: #9b7159;
    --portrait-hood-light: #b58a6d;
    --portrait-hood-shade: #87614e;
    --portrait-hood-inside: #694e41;
    --portrait-skin: #f2d2ae;
    --portrait-hair: #38302b;
    --portrait-cheek: #e89d7d;
    --portrait-shirt: #f6efdc;
    --portrait-eye-white: #fffdf7;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hood { fill: var(--portrait-hood); }
  .hood-light { fill: var(--portrait-hood-light); }
  .hood-shade { fill: var(--portrait-hood-shade); }
  .hood-inside { fill: var(--portrait-hood-inside); }
  .skin { fill: var(--portrait-skin); }
  .hair { fill: var(--portrait-hair); }
  .cheek { fill: var(--portrait-cheek); opacity: .44; }
  .shirt { fill: var(--portrait-shirt); }
  .eye-white { fill: var(--portrait-eye-white); }
  .portrait-lines {
    fill: none;
    stroke: var(--portrait-line);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fine { stroke-width: 1.5; }
  .brows { stroke-width: 3.5; }
  .glasses { stroke-width: 4.5; }
  .eyes { stroke-width: 13; }
  .eye-sparkle { stroke: var(--portrait-eye-white); stroke-width: 4.8; }
  .cord { stroke: var(--portrait-shirt); stroke-width: 2.7; }
  .stroke { stroke-dasharray: 1 2; stroke-dashoffset: 0; }
  .hero-portrait[data-drawing] .stroke {
    animation: portrait-line .46s ease-out both;
    animation-delay: calc(var(--order) * .135s);
  }
  .hero-portrait[data-drawing] .portrait-colour {
    animation: portrait-colour .65s ease-out 1.55s both;
  }
  @keyframes portrait-line {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes portrait-colour {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-portrait[data-drawing] .stroke,
    .hero-portrait[data-drawing] .portrait-colour { animation: none; }
  }
</style>
