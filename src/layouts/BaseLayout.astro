---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '@fontsource-variable/manrope';
import '@fontsource-variable/noto-sans-sc';
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
interface Props { title?: string; description?: string; article?: { publishedAt: Date; updatedAt?: Date; author: string }; noindex?: boolean; }
const { title, description = site.description, article, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — KANE` : 'KANE — Software Engineer & AI Builder';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site!);
const shareImage = new URL('/og.png', Astro.site!);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="KANE" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="KANE — Software Engineer / AI Builder，AI 编程工作流与开发者工具" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {article && <>
      <meta property="article:published_time" content={article.publishedAt.toISOString()} />
      {article.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
      <meta name="author" content={article.author} />
    </>}
    <link rel="alternate" type="application/rss+xml" title="KANE 的文章" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="swap" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main" tabindex="-1" transition:animate={fade({ duration: '0.18s' })}><slot /></main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
