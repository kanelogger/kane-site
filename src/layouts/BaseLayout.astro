---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { site } from '../data/site';
import { getLocaleFromPath, getLocalePath, type Locale, getDictionary } from '../lib/i18n';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
interface Props { title?: string; description?: string; article?: { publishedAt: Date; updatedAt?: Date; author: string }; noindex?: boolean; layout?: 'site' | 'workspace'; locale?: Locale; alternatePath?: string | null; }
const { title, description, article, noindex = false, layout = 'site', locale: propLocale, alternatePath: propAlternatePath } = Astro.props;
const locale = propLocale ?? getLocaleFromPath(Astro.url.pathname);
const dictionary = getDictionary(locale);
const resolvedDescription = description ?? (locale === 'en' ? 'Kane’s personal site about AI Coding Agents, Agent Harnesses, developer tools, and AI-native software engineering.' : site.description);
const pageTitle = title ? `${title} — KANE` : 'KANE — Software Engineer & AI Builder';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site!);
const shareImage = new URL('/og.png', Astro.site!);
const alternateLocale = locale === 'en' ? 'zh-CN' : 'en';
const alternatePath = propAlternatePath === undefined ? getLocalePath(alternateLocale, Astro.url.pathname) : propAlternatePath;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f6f0" />
    <ThemeInit />
    <meta name="description" content={resolvedDescription} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="KANE" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'en' ? 'KANE — Software Engineer / AI Builder, AI coding workflows and developer tools' : 'KANE — Software Engineer / AI Builder，AI 编程工作流与开发者工具'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={shareImage} />
    {article && <>
      <meta property="article:published_time" content={article.publishedAt.toISOString()} />
      {article.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
      <meta name="author" content={article.author} />
    </>}
    {alternatePath && <><link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternateLocale} href={new URL(alternatePath, Astro.site!)} />
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalePath('zh-CN', Astro.url.pathname), Astro.site!)} /></>}
    <link rel="alternate" type="application/rss+xml" title={locale === 'en' ? 'KANE writing' : 'KANE 的文章'} href={getLocalePath(locale, '/rss.xml')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="swap" />
    <title>{pageTitle}</title>
  </head>
  <body id="top" data-layout={layout}>
    <a class="skip-link" href={layout === 'workspace' ? '#workspace-content' : '#main'}>{dictionary.common.skipToMain}</a>
    {layout === 'site' && <Header locale={locale} alternateHref={alternatePath ?? getLocalePath(alternateLocale, '/')} />}
    <main id="main" tabindex="-1" transition:animate={fade({ duration: '0.18s' })}><slot /></main>
    {layout === 'site' && <Footer />}
    <script>
      import '../scripts/motion';
      import '../scripts/theme';
      import '../scripts/content-browser';
    </script>
  </body>
</html>
