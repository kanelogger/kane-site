---
import BaseLayout from './BaseLayout.astro';
import { getLocaleFromPath, normalizeLocale, type Locale } from '../lib/i18n';
import '../styles/workspace.css';

interface Props { title: string; description: string; active: 'dashboard' | 'writing' | 'work' | 'apps' | 'about'; locale?: Locale; }
const { title, description } = Astro.props;
const locale = normalizeLocale(Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname));
---
<BaseLayout title={title} description={description} locale={locale}>
  <section class="shell workspace-content" id="workspace-content" tabindex="-1">
    <slot />
  </section>
</BaseLayout>
