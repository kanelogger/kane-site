---
import { getCollection } from 'astro:content';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import ContentBrowser from '../../components/ContentBrowser.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<WorkspaceLayout title="作品" description="Skill Port、QuotaBar 与 Kane Skills：Kane 的 AI 编程工作流和开发者工具项目。" active="work"><ContentBrowser title="作品" description="从反复遇到的问题出发，把方法做成能用的工具。" projects={projects} /></WorkspaceLayout>
