---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { readFileSync } from 'node:fs';
import { imageSize } from 'image-size';
export async function getStaticPaths() { return (await getCollection('projects')).map((project) => ({ params: { slug: project.id }, props: { project } })); }
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
const coverSize = imageSize(readFileSync(`public${data.cover}`));
const { Content, headings } = await render(project);
---
<ArticleLayout title={data.title} description={data.description} headings={headings}>
  <header slot="header" class="detail-header project-detail-header"><p class="eyebrow">PROJECT / {data.year}</p><h1>{data.title}</h1><p class="detail-description">{data.description}</p><dl class="project-facts"><div><dt>角色 / ROLE</dt><dd>{data.role}</dd></div><div><dt>领域 / FOCUS</dt><dd>{data.tags.join(' / ')}</dd></div></dl><div class="project-actions"><a class="button" href={data.github}>GitHub ↗</a>{data.release && <a class="text-link" href={data.release}>查看 Releases ↗</a>}{data.designDoc && <a class="text-link" href={data.designDoc}>阅读文档 ↗</a>}</div></header>
  <figure slot="cover" class:list={['project-detail-cover', { 'skills-cover': project.id === 'kane-skills' }]}>{project.id === 'kane-skills' && <div class="skills-cover-label"><strong>KANE<br/>SKILLS</strong><span>28 REUSABLE AGENT SKILLS</span></div>}<img src={data.cover} alt={`${data.title} 项目封面`} width={coverSize.width} height={coverSize.height} fetchpriority="high" /></figure>
  <Content />
  <div slot="after" class="detail-end"><span>继续探索。</span><a class="text-link" href="/work">查看全部作品 ↗</a></div>
</ArticleLayout>
