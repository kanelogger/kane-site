---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Contacts from '../components/Contacts.astro';
import KineticSculpture from '../components/KineticSculpture.astro';
import { site } from '../data/site';
const [allProjectsRaw, allArticlesRaw] = await Promise.all([getCollection('projects'), getCollection('blog')]);
const allProjects = allProjectsRaw.filter(({ data }) => data.locale === 'zh-CN');
const allArticles = allArticlesRaw.filter(({ data }) => data.locale === 'zh-CN');
const projects = allProjects.filter(({ data }) => data.featured).sort((a, b) => a.data.order - b.data.order);
const articles = allArticles.filter(({ data }) => data.featured).sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!).slice(0, 4);
---
<BaseLayout>
  <div data-home>
    <section class="shell hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker" data-home-intro><span aria-hidden="true">+</span> CODING AGENT / HARNESS / TOOLS</p>
          <h1 id="hero-title" data-home-intro>研究 AI 原生开发，<span>把方法做成工具。</span></h1>
          <p class="hero-description" data-home-intro>我是 Kane，软件工程师。探索 Agent 的上下文、验证与反馈，记录能在真实项目中复用的工程实践。</p>
          <div class="hero-actions" data-home-intro><a class="button" href="/dashboard">进入内容 <span aria-hidden="true">↗</span></a><a class="text-link" href="#selected-work">探索作品 <span aria-hidden="true">↓</span></a></div>
        </div>
        <KineticSculpture />
      </div>
      <div class="hero-index"><div><span class="meta">INDEX /</span><p>从工具，到工程方法</p></div><div class="hero-counts"><a href="/work"><strong>{String(allProjects.length).padStart(2, '0')}</strong> 个作品</a><a href="/writing"><strong>{String(allArticles.length).padStart(2, '0')}</strong> 篇文章</a></div><a class="text-link" href={site.contacts[0].href}>GitHub <span aria-hidden="true">↗</span></a></div>
    </section>
  <section class="shell section" id="selected-work" aria-labelledby="work-heading">
    <div class="section-heading" data-home-reveal><div><h2 id="work-heading">把想法，做成工具。</h2></div><a class="text-link" href="/work">全部作品 <span aria-hidden="true">↗</span></a></div>
    <div class="project-list">{projects.map((project) => <ProjectCard project={project} locale="zh-CN" />)}</div>
  </section>
  <section class="writing-section" aria-labelledby="writing-heading"><div class="shell section">
    <div class="section-heading" data-home-reveal><div><h2 id="writing-heading">实践之后，留下记录。</h2></div><a class="text-link" href="/writing">全部文章 <span aria-hidden="true">↗</span></a></div>
    <div class="article-list">{articles.map((article) => <ArticleCard article={article} locale="zh-CN" />)}</div>
  </div></section>
  <section class="shell section home-about" aria-labelledby="about-heading"><div data-home-reveal><h2 id="about-heading">你好，我是 Kane。</h2></div><div data-home-reveal>{site.about.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href="/about">更多关于我 <span aria-hidden="true">↗</span></a><Contacts /></div></section>
  </div>
</BaseLayout>
