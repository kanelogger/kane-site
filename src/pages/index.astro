---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Contacts from '../components/Contacts.astro';
import { site } from '../data/site';
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('blog', ({ data }) => data.featured)).sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!).slice(0, 4);
---
<BaseLayout>
  <section class="shell hero" aria-labelledby="hero-title">
    <div class="hero-eyebrow meta" data-intro><span>SOFTWARE ENGINEER / AI BUILDER</span><span>PERSONAL SITE — 2026</span></div>
    <h1 class="hero-title" id="hero-title" data-intro>KANE<span aria-hidden="true">↗</span></h1>
    <div class="hero-bottom"><div data-intro><p class="hero-position">构建更可靠的 AI 编程<br class="desktop-break"/>工作流与开发者工具。</p><p class="hero-tagline">{site.tagline}</p></div><div class="hero-description" data-intro><p>{site.intro}</p><div class="hero-actions"><a class="button" href="/work">查看作品 <span aria-hidden="true">↗</span></a><a class="text-link" href="/writing">阅读文章 <span aria-hidden="true">↗</span></a></div></div></div>
    <a class="hero-scroll meta" href="#selected-work">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
  </section>
  <section class="shell section" id="selected-work" aria-labelledby="work-heading">
    <div class="section-heading" data-reveal><div><span class="eyebrow">01 / SELECTED WORK</span><h2 id="work-heading">把想法，做成工具。</h2></div><a class="text-link" href="/work">全部作品 <span aria-hidden="true">↗</span></a></div>
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </section>
  <section class="writing-section" aria-labelledby="writing-heading"><div class="shell section">
    <div class="section-heading" data-reveal><div><span class="eyebrow">02 / SELECTED WRITING</span><h2 id="writing-heading">实践之后，留下记录。</h2></div><a class="text-link" href="/writing">全部文章 <span aria-hidden="true">↗</span></a></div>
    <div class="article-list">{articles.map((article) => <ArticleCard article={article} />)}</div>
  </div></section>
  <section class="shell section home-about" aria-labelledby="about-heading"><div data-reveal><span class="eyebrow">03 / A LITTLE ABOUT ME</span><h2 id="about-heading">你好，我是 Kane。</h2></div><div data-reveal>{site.about.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href="/about">更多关于我 <span aria-hidden="true">↗</span></a><Contacts /></div></section>
</BaseLayout>
