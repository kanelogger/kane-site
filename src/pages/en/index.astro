---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Contacts from '../../components/Contacts.astro';
import KineticSculpture from '../../components/KineticSculpture.astro';
import { siteByLocale } from '../../data/site';
const site = siteByLocale.en;
const [allProjects, allArticles] = await Promise.all([
  getCollection('projects', ({ data }) => data.locale === 'en'),
  getCollection('blog', ({ data }) => data.locale === 'en'),
]);
const projects = allProjects.filter(({ data }) => data.featured && data.translationStatus === 'reviewed').sort((a, b) => a.data.order - b.data.order);
const articles = allArticles.filter(({ data }) => data.featured && data.translationStatus !== 'summary').sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!).slice(0, 4);
---
<BaseLayout locale="en" description={site.description}>
  <div data-home>
    <section class="shell hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker" data-home-intro><span aria-hidden="true">+</span> CODING AGENT / HARNESS / TOOLS</p>
          <h1 id="hero-title" data-home-intro>Study AI-native development, <span>turn methods into tools.</span></h1>
          <p class="hero-description" data-home-intro>I’m Kane, a software engineer. I explore agent context, verification, and feedback, and record engineering practices that can be reused in real projects.</p>
          <div class="hero-actions" data-home-intro><a class="button" href="/en/dashboard">Explore content <span aria-hidden="true">↗</span></a><a class="text-link" href="#selected-work">Explore work <span aria-hidden="true">↓</span></a></div>
        </div>
        <KineticSculpture />
      </div>
      <div class="hero-index"><div><span class="meta">INDEX /</span><p>From tools to engineering methods</p></div><div class="hero-counts"><a href="/en/work"><strong>{String(allProjects.length).padStart(2, '0')}</strong> projects</a><a href="/en/writing"><strong>{String(allArticles.length).padStart(2, '0')}</strong> articles</a></div><a class="text-link" href={site.contacts[0].href}>GitHub <span aria-hidden="true">↗</span></a></div>
    </section>
    <section class="shell section" id="selected-work" aria-labelledby="work-heading"><div class="section-heading" data-home-reveal><div><h2 id="work-heading">Turn ideas into tools.</h2></div><a class="text-link" href="/en/work">All work <span aria-hidden="true">↗</span></a></div><div class="project-list">{projects.map((project) => <ProjectCard project={project} locale="en" />)}</div></section>
    <section class="writing-section" aria-labelledby="writing-heading"><div class="shell section"><div class="section-heading" data-home-reveal><div><h2 id="writing-heading">Leave a record after practice.</h2></div><a class="text-link" href="/en/writing">All writing <span aria-hidden="true">↗</span></a></div><div class="article-list">{articles.map((article) => <ArticleCard article={article} locale="en" />)}</div></div></section>
    <section class="shell section home-about" aria-labelledby="about-heading"><div data-home-reveal><h2 id="about-heading">Hi, I’m Kane.</h2></div><div data-home-reveal>{site.about.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href="/en/about">More about me <span aria-hidden="true">↗</span></a><Contacts /></div></section>
  </div>
</BaseLayout>
