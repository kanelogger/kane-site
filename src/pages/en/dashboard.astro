---
import { getCollection } from 'astro:content';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import ContentBrowser from '../../components/ContentBrowser.astro';
import { sortArticles } from '../../lib/content';
const articles = (await getCollection('blog', ({ data }) => data.locale === 'en')).sort(sortArticles);
const projects = (await getCollection('projects', ({ data }) => data.locale === 'en')).sort((a, b) => a.data.order - b.data.order);
---
<WorkspaceLayout title="Content index" description="Developer tools, agent workflows, and engineering practice." active="dashboard" locale="en"><ContentBrowser title="Content index" description="Developer tools, agent workflows, and engineering practice." articles={articles} projects={projects} locale="en" categories /></WorkspaceLayout>
