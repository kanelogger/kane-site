---
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import Contacts from '../../components/Contacts.astro';
import { siteByLocale } from '../../data/site';
const site = siteByLocale.en;
---
<WorkspaceLayout title="About Kane" description={site.description} active="about" locale="en">
  <header class="workspace-heading"><div><h1>About Kane</h1></div></header>
  <div class="workspace-about"><div class="workspace-about-copy">{site.about.map((paragraph) => <p>{paragraph}</p>)}<section class="workspace-about-contact" aria-labelledby="contact-heading"><h2 id="contact-heading">Contact</h2><p>For collaboration, technical exchange, or article feedback, reach me through GitHub or X.</p><Contacts detailed locale="en" /></section></div></div>
</WorkspaceLayout>
