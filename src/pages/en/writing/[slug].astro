---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { formatDate, readingMinutes } from '../../../lib/content';
export async function getStaticPaths() {
  return (await getCollection('blog', ({ data }) => data.locale === 'en' && data.translationStatus === 'reviewed')).map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}
interface Props { article: CollectionEntry<'blog'>; }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const alternatePath = `/writing/${article.data.slug}`;
---
<ArticleLayout title={article.data.title} description={article.data.description} headings={headings} article={article.data} locale="en" alternatePath={alternatePath}>
  <header slot="header" class="detail-header"><p class="eyebrow">{article.data.category}</p><h1>{article.data.title}</h1><p class="detail-description">{article.data.description}</p><div class="detail-meta meta"><span>{article.data.author}</span><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time><span>{readingMinutes(article.body)} min read</span>{article.data.updatedAt && <span>Updated {formatDate(article.data.updatedAt)}</span>}</div><ul class="tags">{article.data.tags.map((tag) => <li>{tag}</li>)}</ul></header>
  <Content />
  <div slot="after" class="detail-end"><span>Thanks for reading.</span><a class="text-link" href="/en/writing">Continue reading ↗</a></div>
</ArticleLayout>
