---
import { getCollection } from 'astro:content';
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import ContentBrowser from '../../../components/ContentBrowser.astro';
import { sortArticles } from '../../../lib/content';
const articles = (await getCollection('blog', ({ data }) => data.locale === 'en')).sort(sortArticles);
---
<WorkspaceLayout title="Writing" description="Practice notes on AI Coding Agents, Agent Harnesses, developer tools, and AI-native software engineering." active="writing" locale="en"><ContentBrowser title="Writing" description="Record engineering practice, unpack tools, connect ideas." articles={articles} categories locale="en" /></WorkspaceLayout>
