---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { formatDate, readingMinutes } from '../../lib/content';
export async function getStaticPaths() { return (await getCollection('blog')).map((article) => ({ params: { slug: article.id }, props: { article } })); }
interface Props { article: CollectionEntry<'blog'>; }
const { article } = Astro.props;
const { Content, headings } = await render(article);
---
<ArticleLayout title={article.data.title} description={article.data.description} headings={headings} article={article.data}>
  <header slot="header" class="detail-header"><p class="eyebrow">{article.data.category}</p><h1>{article.data.title}</h1><p class="detail-description">{article.data.description}</p><div class="detail-meta meta"><span>{article.data.author}</span><time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time><span>约 {readingMinutes(article.body)} 分钟阅读</span>{article.data.updatedAt && <span>更新于 {formatDate(article.data.updatedAt)}</span>}</div><ul class="tags">{article.data.tags.map((tag) => <li>{tag}</li>)}</ul></header>
  <Content />
  <div slot="after" class="detail-end"><span>感谢阅读。</span><a class="text-link" href="/writing">继续阅读其他文章 ↗</a></div>
</ArticleLayout>
