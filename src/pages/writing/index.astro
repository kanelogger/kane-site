---
import { getCollection } from 'astro:content';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import ContentBrowser from '../../components/ContentBrowser.astro';
import { sortArticles } from '../../lib/content';
const articles = (await getCollection('blog')).filter(({ data }) => data.locale === 'zh-CN').sort(sortArticles);
---
<WorkspaceLayout title="文章" description="关于 AI Coding Agent、Agent Harness、开发者工具与 AI 原生软件工程的实践记录。" active="writing"><ContentBrowser title="文章" description="记录工程实践，拆解工具，连接想法。" articles={articles} categories /></WorkspaceLayout>
